{
  "name": "dubravka-shop",
  "private": true,
  "version": "0.1.0",
  "description": "«Магазин бабушки» — браузерный 3D-симулятор деревенского магазина (Three.js)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run models && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "models": "tsx tools/export-models.ts",
    "asset-table": "tsx tools/gen-asset-table.ts",
    "e2e": "node tools/e2e/run.mjs"
  },
  "dependencies": {
    "@fontsource/pt-serif": "^5.3.0",
    "@fontsource/roboto-condensed": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "playwright-core": "1.56.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
